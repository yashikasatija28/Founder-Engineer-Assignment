# Copy this file to .env and fill in your values.

# OpenAI-compatible API key (required for live operator runs)
OPENAI_API_KEY=sk-...

# Optional: point at a different OpenAI-compatible endpoint (e.g. Azure, local Ollama)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use for tool-calling (must support function calling)
OPENAI_MODEL=gpt-4o

# Portal URL (default works when running portal with default settings)
PORTAL_URL=http://localhost:8000

# Directory that contains the company context files
COMPANY_DIR=company
